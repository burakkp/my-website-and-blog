---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
export async function getStaticPaths() { return (await getCollection('projects')).map(project => ({ params: { slug: project.id }, props: { project } })); }
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
---
<SiteLayout title={`${project.data.title} | Burak`} description={project.data.summary}><div class="reading"><header class="page-heading"><a class="eyebrow" href="/#projects">The project shelf / {project.data.category}</a><h1>{project.data.title}</h1><p class="intro">{project.data.summary}</p>{(project.data.website || project.data.repo) && <p class="hero-links">{project.data.website && <a class="button" href={project.data.website}>Visit the project</a>}{project.data.repo && <a class="text-link" href={project.data.repo}>Source code</a>}</p>}</header><article class="prose prose-green dark:prose-invert max-w-none"><Content /></article><p class="back-link"><a class="text-link" href="/#projects">Explore all projects</a></p></div></SiteLayout>
