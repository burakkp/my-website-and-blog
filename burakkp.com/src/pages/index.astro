---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import ExperienceList from '../components/ExperienceList.astro';
import OpenSource from '../components/OpenSource.astro';
import { getCollection } from 'astro:content';
import { profile } from '../lib/profile';
import { getPortfolioRepos } from '../lib/github';
const hasExperience = (await getCollection('experience')).length > 0;
const repos = await getPortfolioRepos();
---
<SiteLayout>
  <section class="hero"><div><p class="eyebrow">{profile.greeting}</p><h1>Cloud. Code.<br /><span>Things you<br />can hold.</span></h1><p class="intro">{profile.intro}</p><div class="hero-links"><a class="button" href="#projects">Explore projects</a><a class="text-link" href="https://burakkp.dev">Read the notebook</a></div></div><div class="terminal" aria-label="Areas of practice"><div class="terminal-bar"><span>~/workbench</span><span>burakkp</span></div><div class="terminal-content"><p><span class="prompt">$</span> cat interests.txt</p><ul>{profile.interests.map(item => <li>{item}</li>)}</ul><p class="terminal-note">{profile.terminalNote}</p><span class="prompt" aria-hidden="true">$ _</span></div><div class="terminal-foot">A place to build and figure things out.</div></div></section>
  <section id="projects" aria-labelledby="projects-title"><div class="section-heading"><div><p class="eyebrow">The project shelf</p><h2 id="projects-title">Selected projects.</h2></div><p>Four names. A growing body of work.</p></div><ProjectsGrid /></section>
  {hasExperience && <section id="experience" aria-labelledby="experience-title" class="experience"><div class="section-heading"><div><p class="eyebrow">Where I’ve worked</p><h2 id="experience-title">Experience.</h2></div>{profile.links.linkedin && <a class="text-link" href={profile.links.linkedin}>Full profile on LinkedIn</a>}</div><ExperienceList /></section>}
  {repos.length > 0 && <section id="open-source" aria-labelledby="open-source-title" class="open-source"><div class="section-heading"><div><p class="eyebrow">Fresh from GitHub</p><h2 id="open-source-title">Open source.</h2></div>{profile.links.github && <a class="text-link" href={profile.links.github}>All repositories</a>}</div><OpenSource repos={repos} /></section>}
  <section id="practice" aria-labelledby="practice-title" class="practice"><div><p class="eyebrow">From systems to objects</p><h2 id="practice-title">One curious<br />workbench.</h2></div><div class="practice-list"><article><span class="practice-symbol" aria-hidden="true">[ ]</span><div><h3>Cloud architecture</h3><p>Infrastructure, Linux administration, and the systems behind the software.</p></div></article><article><span class="practice-symbol" aria-hidden="true">&#123; &#125;</span><div><h3>Software & small tools</h3><p>SaaS projects, Go, and Cloudflare Workers. Exploring ideas through code.</p></div></article><article><span class="practice-symbol" aria-hidden="true">&lt; &gt;</span><div><h3>Digital to physical</h3><p>Parametric modeling in OpenSCAD and fabrication through 3D printing.</p></div></article></div></section>
  <section class="writing-callout"><p class="eyebrow">The other half of building</p><h2>Leave a trail of notes.</h2><p>Experiments, technical notes, and lessons from the workbench live on my engineering blog.</p><a class="button" href="https://burakkp.dev">Visit burakkp.dev</a></section>
</SiteLayout>
