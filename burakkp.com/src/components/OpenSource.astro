---
import type { Repo } from '../lib/github';
interface Props { repos: Repo[]; }
const { repos } = Astro.props;
---
<ul class="repo-grid">{repos.map(repo => <li class="repo-card"><a class="repo-name" href={repo.url}>{repo.name}</a>{repo.description && <p>{repo.description}</p>}<p class="repo-meta">{repo.language && <span>{repo.language}</span>}{repo.stars > 0 && <span>★ {repo.stars}</span>}{repo.homepage && <a href={repo.homepage}>Live site</a>}</p></li>)}</ul>
