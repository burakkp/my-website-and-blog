---
import { getPublishedPosts } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
const posts = await getPublishedPosts();
---
<ul class="post-list">
{posts.map(post => <li><div class="post-meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.topic}</span></div><div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></div></li>)}
</ul>
