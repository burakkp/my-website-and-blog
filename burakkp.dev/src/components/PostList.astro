---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<ul class="post-list">
{posts.map(post => <li><div class="post-meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.topic}</span></div><div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><span class="sample-label">Starter article</span></div></li>)}
</ul>
